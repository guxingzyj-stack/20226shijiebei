# Copy this file to .env before self-hosting.
# Never commit real passwords, connection strings, JWT secrets, or API keys.

POSTGRES_DB=worldcup
POSTGRES_USER=worldcup_app
POSTGRES_PASSWORD=change_me_to_a_long_random_password

# Docker Compose internal PostgreSQL URL. Keep host as "postgres" inside compose.
DATABASE_URL=postgresql://worldcup_app:change_me_to_a_long_random_password@postgres:5432/worldcup

JWT_SECRET=change_me_to_a_long_random_secret
THE_ODDS_API_KEY=

MODEL_WORKER_ENABLED=true
BETTING_ENABLED=false
PYTHONUNBUFFERED=1

# Browser-facing API base URL used when building web assets.
VITE_API_BASE_URL=http://localhost:8000
VITE_BETTING_ENABLED=false

# Comma-separated allowed browser origins for API CORS.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173
